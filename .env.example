# Staging only. Use secure environment storage; never commit real values.
ALCHEMY_STAGE=staging
ALCHEMY_PROFILE=default
STRIPE_API_KEY=
CLIPFORGE_APP_ORIGIN=https://staging.example.invalid
CLIPFORGE_AUTH_SECRET=
CLIPFORGE_INTERNAL_SECRET=
CLIPFORGE_EMAIL_FROM=hello@staging.example.invalid
# cloudflare requires a verified Cloudflare Email Sending domain;
# resend requires CLIPFORGE_EMAIL_API_KEY.
CLIPFORGE_EMAIL_PROVIDER=cloudflare
CLIPFORGE_EMAIL_API_KEY=
