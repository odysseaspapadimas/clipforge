# Staging only. Use secure environment storage; never commit real values.
ALCHEMY_STAGE=staging
ALCHEMY_PROFILE=default
STRIPE_API_KEY=
# Must equal the Cloudflare account selected by the Alchemy profile.
CLIPFORGE_EXPECTED_CF_ACCOUNT_ID=
# Replace <account-subdomain> with the account's actual workers.dev label.
CLIPFORGE_APP_ORIGIN=https://clipforge-staging-web.<account-subdomain>.workers.dev
CLIPFORGE_AUTH_SECRET=
CLIPFORGE_INTERNAL_SECRET=
# workers.dev cannot be the outbound sender; use an onboarded domain you control.
CLIPFORGE_EMAIL_FROM=
# cloudflare requires a verified Cloudflare Email Sending domain;
# resend requires CLIPFORGE_EMAIL_API_KEY.
CLIPFORGE_EMAIL_PROVIDER=cloudflare
CLIPFORGE_EMAIL_API_KEY=
# workers-ai is the default; deepgram is an explicit, separately keyed fallback.
CLIPFORGE_TRANSCRIPTION_BACKEND=workers-ai
CLIPFORGE_DEEPGRAM_KEY=
