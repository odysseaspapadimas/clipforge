# Local development only. Keep secrets and staging/deploy credentials out of this file.
# Data-only dotenv files: one shared across Clipforge worktrees, then one checkout override.
shared_local_env="${XDG_CONFIG_HOME:-$HOME/.config}/project-env/clipforge/local.env"
watch_file "$shared_local_env" .env.local
dotenv_if_exists "$shared_local_env"
dotenv_if_exists .env.local
